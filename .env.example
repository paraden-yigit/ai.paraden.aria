# Base URL of the REST API. Keep this on plain localhost (not a subdomain) so the
# session cookies are same-site with this app and sent on every request.
VITE_API_BASE_URL=http://localhost:8000

# Application-level API key sent as the `X-API-Key` header on every request.
# The whole API is gated behind this key (see /openapi.json securitySchemes).
VITE_API_KEY=your-api-key-here

# Marketing site (ai.paraden) URL — used for the "back to site", waitlist, and
# legal links on the login screen.
VITE_MARKETING_URL=http://localhost:3000
